{
  "openapi": "3.0.0",
  "info": {
    "title": "Contoso IT Helpdesk Agent (via APIM)",
    "description": "Send a natural-language IT helpdesk question and get a plain-text answer from the Contoso IT Helpdesk Agent through Azure API Management.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://<your-apim-service>.azure-api.net/contoso/itdesk",
      "description": "Azure API Management gateway. Patched at runtime from config.json (apim_service_name + apim_api_path)."
    }
  ],
  "security": [
    {
      "apimSubscriptionKey": []
    }
  ],
  "paths": {
    "/query": {
      "post": {
        "operationId": "queryContosoITHelpdesk",
        "summary": "Query the Contoso IT Helpdesk Agent",
        "description": "Send one natural-language IT helpdesk question and return one plain-text answer covering incidents, service requests, and IT policies.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["messages"],
                "properties": {
                  "messages": {
                    "type": "array",
                    "description": "Conversation messages. The last user message is treated as the question.",
                    "items": {
                      "type": "object",
                      "required": ["role", "content"],
                      "properties": {
                        "role": {
                          "type": "string",
                          "description": "Message role: 'user' or 'assistant'"
                        },
                        "content": {
                          "type": "array",
                          "description": "Message content parts",
                          "items": {
                            "type": "object",
                            "properties": {
                              "type": {
                                "type": "string",
                                "description": "Content type, e.g. 'text'"
                              },
                              "text": {
                                "type": "string",
                                "description": "Text content of this part"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              },
              "example": {
                "messages": [
                  {
                    "role": "user",
                    "content": [
                      {
                        "type": "text",
                        "text": "How many open P2 incidents are there right now?"
                      }
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "answer": {
                      "type": "string",
                      "description": "Plain-text answer from the helpdesk agent"
                    }
                  }
                },
                "example": {
                  "answer": "There are currently 3 open P2 incidents. The most recent is INC-00234 regarding VPN connectivity in the Seattle office, opened 2 hours ago and assigned to the Network Operations team."
                }
              }
            }
          },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" },
          "500": { "description": "Server error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apimSubscriptionKey": {
        "type": "apiKey",
        "in": "header",
        "name": "Ocp-Apim-Subscription-Key"
      }
    }
  }
}
